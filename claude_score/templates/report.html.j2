<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ClaudeScore — {{ candidate }}</title>
<style>
  :root {
    --bg: #0f1117; --card: #181b24; --line: #272b36; --txt: #e6e8ee;
    --muted: #9aa3b2; --accent: #6ee7b7; --accent2: #60a5fa; --warn: #f59e0b;
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--txt);
    font: 15px/1.5 -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
  .wrap { max-width: 920px; margin: 0 auto; padding: 32px 20px 80px; }
  header { border-bottom: 1px solid var(--line); padding-bottom: 20px; margin-bottom: 28px; }
  .brand { color: var(--accent); font-weight: 700; letter-spacing: .5px; font-size: 13px;
    text-transform: uppercase; }
  h1 { margin: 4px 0 2px; font-size: 30px; }
  .sub { color: var(--muted); font-size: 13px; }
  h2 { font-size: 15px; text-transform: uppercase; letter-spacing: .6px; color: var(--muted);
    margin: 36px 0 14px; }
  .card { background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 18px 20px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 12px; }
  .metric { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 12px 14px; }
  .metric .v { font-size: 20px; font-weight: 700; }
  .metric .l { color: var(--muted); font-size: 12px; margin-top: 2px; }
  .badges { display: flex; flex-wrap: wrap; gap: 12px; }
  .badge { background: var(--card); border: 1px solid var(--line); border-radius: 12px;
    padding: 12px 14px; flex: 1 1 240px; }
  .badge .top { font-weight: 700; }
  .badge .emoji { font-size: 22px; margin-right: 6px; }
  .badge .desc { color: var(--muted); font-size: 13px; margin: 4px 0; }
  .badge .cite { font-size: 12px; color: var(--accent); }
  .bar { height: 8px; background: #11141c; border-radius: 6px; overflow: hidden; margin-top: 6px; }
  .bar > span { display: block; height: 100%; background: linear-gradient(90deg, var(--accent2), var(--accent)); }
  .scorerow { display: grid; grid-template-columns: 160px 1fr 44px; gap: 10px; align-items: center; margin: 8px 0; }
  .scorerow .n { color: var(--muted); font-size: 13px; }
  .scorerow .num { text-align: right; font-weight: 700; }
  .toolrow { display: grid; grid-template-columns: 130px 1fr 70px; gap: 10px; align-items: center; margin: 6px 0; }
  .pill { display: inline-block; background: #11141c; border: 1px solid var(--line);
    border-radius: 999px; padding: 2px 10px; font-size: 12px; color: var(--muted); margin: 2px 4px 2px 0; }
  ul.clean { margin: 6px 0; padding-left: 18px; }
  ul.clean li { margin: 4px 0; }
  .replay { max-height: 460px; overflow: auto; }
  .turn { border-left: 2px solid var(--accent2); padding: 4px 0 4px 12px; margin: 10px 0; }
  .turn .t { color: var(--muted); font-size: 11px; }
  .turn .x { white-space: pre-wrap; word-break: break-word; }
  .note { color: var(--muted); font-size: 12px; }
  footer { margin-top: 40px; color: var(--muted); font-size: 12px; border-top: 1px solid var(--line); padding-top: 16px; }
</style>
</head>
<body>
<div class="wrap">
  <header>
    <div class="brand">◍ ClaudeScore</div>
    <h1>{{ candidate }}</h1>
    <div class="sub">Generated {{ generated_at }} ·
      {% if models %}{{ models.keys() | join(", ") }}{% else %}model unknown{% endif %}</div>
  </header>

  {% if judge_scores %}
  <h2>Collaboration scores</h2>
  <div class="card">
    {% for s in judge_scores %}
    <div class="scorerow">
      <div class="n">{{ s.label }}</div>
      <div class="bar"><span style="width: {{ s.pct }}%"></span></div>
      <div class="num">{{ "%.1f"|format(s.value) }}/5</div>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  {% if judge and judge.summary %}
  <h2>Read of the session</h2>
  <div class="card">
    <p>{{ judge.summary }}</p>
    {% if judge.strengths %}<strong>Strengths</strong>
      <ul class="clean">{% for s in judge.strengths %}<li>{{ s }}</li>{% endfor %}</ul>{% endif %}
    {% if judge.concerns %}<strong>Watch-outs</strong>
      <ul class="clean">{% for c in judge.concerns %}<li>{{ c }}</li>{% endfor %}</ul>{% endif %}
  </div>
  {% elif judge and judge.error %}
  <p class="note">Judge skipped: {{ judge.error }}</p>
  {% endif %}

  <h2>Badges</h2>
  {% if badges %}
  <div class="badges">
    {% for b in badges %}
    <div class="badge">
      <div class="top"><span class="emoji">{{ b.emoji }}</span>{{ b.name }}</div>
      <div class="desc">{{ b.description }}</div>
      <div class="cite">{{ b.citation }}</div>
    </div>
    {% endfor %}
  </div>
  {% else %}
  <p class="note">No trait badges triggered for this session.</p>
  {% endif %}

  <h2>Metrics</h2>
  <div class="grid">
    {% for label, value in key_metrics %}
    <div class="metric"><div class="v">{{ value }}</div><div class="l">{{ label }}</div></div>
    {% endfor %}
  </div>

  {% if tools %}
  <h2>Tool usage</h2>
  <div class="card">
    {% for t in tools %}
    <div class="toolrow">
      <div class="n">{{ t.name }}</div>
      <div class="bar"><span style="width: {{ t.pct }}%"></span></div>
      <div class="num">{{ t.count }}</div>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  <h2>Prompt replay <span class="note">({{ replay|length }} prompts)</span></h2>
  <div class="card replay">
    {% for r in replay %}
    <div class="turn"><div class="t">{{ r.time }}</div><div class="x">{{ r.text }}</div></div>
    {% else %}
    <p class="note">No human prompts found.</p>
    {% endfor %}
  </div>

  <footer>
    ClaudeScore senses how a developer collaborates with Claude Code. Token costs are
    estimates; politeness and badge heuristics are directional, not diagnostic.
  </footer>
</div>
</body>
</html>
